BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 120
NamespaceIndentation: All

# Braces
BreakBeforeBraces: Attach
Cpp11BracedListStyle: false          # "{ 1.f, 1.f, 1.f, 1.f }" with spaces

# Pointers / refs  (your files always use Type* / Type&)
PointerAlignment: Left
ReferenceAlignment: Pointer
DerivePointerAlignment: false

# Short functions
AllowShortFunctionsOnASingleLine: Inline   # header-only bodies, e.g. is_valid(), set_bool()
AllowShortIfStatementsOnASingleLine: Never

# Blank lines (caps only — see §2)
MaxEmptyLinesToKeep: 2
EmptyLineBeforeAccessModifier: Always
EmptyLineAfterAccessModifier:  Always

# Alignment
AlignConsecutiveDeclarations: false      # see §2 — clang-format can't reach your columns
AlignConsecutiveAssignments: false
AlignConsecutiveMacros: false
AlignTrailingComments: false             # trailing // comments in sun_settings aren't aligned

# Ternary:  break BEFORE ? and :
BreakBeforeTernaryOperators: true
BreakBeforeBinaryOperators: NonAssignment

# Calls / braced-init wrapping
AlignAfterOpenBracket: BlockIndent
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true

# Comments — never reflow; only the custom script touches "// ... =====" lines
ReflowComments: false

# Includes
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
