{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "debug",
      "description": "debug build with no optimisations",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/gcc-16.2/bin/gcc-16.2",
        "CMAKE_CXX_COMPILER": "/opt/gcc-16.2/bin/g++-16.2",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "release",
      "description": "release build with optimisations, no debug info",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/gcc-16.2/bin/gcc-16.2",
        "CMAKE_CXX_COMPILER": "/opt/gcc-16.2/bin/g++-16.2",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release_with_debug_info",
      "displayName": "release with debug Info",
      "description": "Optimised build but with debug symbols",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release_with_debug_info",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/gcc-16.2/bin/gcc-16.2",
        "CMAKE_CXX_COMPILER": "/opt/gcc-16.2/bin/g++-16.2",
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "32"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "32"
      }
    },
    {
      "name": "release_with_debug_info",
      "configurePreset": "release_with_debug_info",
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "32"
      }
    }
  ]
}