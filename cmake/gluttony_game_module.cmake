# =================================================================================================
# Gluttony game module build
# =================================================================================================
# Included by a project's CMakeLists.txt, BEFORE project() (it selects the engine's compiler):
#
#     cmake_minimum_required(VERSION 3.25)
#     set(GLUTTONY_DIR "$ENV{GLUTTONY_DIR}" CACHE PATH "Gluttony engine source directory")
#     if(NOT GLUTTONY_DIR)
#         set(GLUTTONY_DIR "${CMAKE_CURRENT_LIST_DIR}/../Gluttony" CACHE PATH "Gluttony engine source directory" FORCE)
#     endif()
#     include("${GLUTTONY_DIR}/cmake/gluttony_game_module.cmake")
#     project(my_game LANGUAGES CXX)
#     gluttony_add_game_module(my_game)
#
# gluttony_add_game_module(<target>
#     [MODULE_NAME <id>]            module id + file name (default: <target>)
#     [ROOT_NAMESPACE <ns>]         namespace the module registers from (default: <target>)
#     [SOURCE_DIR <dir>]            default: ${PROJECT_SOURCE_DIR}/game
#     [SOURCES <files...>]          default: every .cpp/.cxx/.c below SOURCE_DIR
#     [ENTRY_HEADERS <files...>]    headers the generated entry point includes (default: every .h/.hpp below SOURCE_DIR)
#     [NO_GENERATED_ENTRY]          write the entry point yourself: GLT_GAME_MODULE(<ns>) from module/game_module.h
#     [LINK <targets/libs...>])     extra libraries
#
# Output: ${PROJECT_SOURCE_DIR}/build/<config>/bin/<id>.so plus <id>.glt_module (the manifest the engine looks for),
# <config> = debug | release | release_with_debug_info. The engine loads the modules of its own configuration from there
# (documentation/game_module.md)
# =================================================================================================

include_guard(GLOBAL)

get_filename_component(_GLT_ENGINE_DIR                                  "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT EXISTS "${_GLT_ENGINE_DIR}/core/src/module/game_module.h")
    message(FATAL_ERROR "gluttony_game_module.cmake: ${_GLT_ENGINE_DIR} is not a Gluttony source directory (set GLUTTONY_DIR)")
endif()

# --- compiler: the module must be built with the compiler the engine was built with -------------------------------------
option(GLUTTONY_USE_ENGINE_COMPILER                                     "Use the engine's GCC 16 toolchain" ON)
if(GLUTTONY_USE_ENGINE_COMPILER AND NOT CMAKE_TOOLCHAIN_FILE AND NOT CMAKE_PROJECT_NAME)
    include("${_GLT_ENGINE_DIR}/cmake/gcc-16.2-toolchain.cmake")
endif()

if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_BUILD_TYPE                                                Debug CACHE STRING "Debug, Release or RelWithDebInfo" FORCE)
endif()

set(CMAKE_EXPORT_COMPILE_COMMANDS                                       ON)

if(EXISTS "${_GLT_ENGINE_DIR}/vendor/tracy/public")
    option(GLUTTONY_TRACY                                               "Instrument the module for Tracy (must match the engine's GLT_ENABLE_TRACY)" ON)
else()
    option(GLUTTONY_TRACY                                               "Instrument the module for Tracy (must match the engine's GLT_ENABLE_TRACY)" OFF)
endif()


function(gluttony_add_game_module TARGET)

    cmake_parse_arguments(GM "NO_GENERATED_ENTRY" "MODULE_NAME;ROOT_NAMESPACE;SOURCE_DIR" "SOURCES;ENTRY_HEADERS;LINK" ${ARGN})

    if(NOT GM_MODULE_NAME)
        set(GM_MODULE_NAME                                              "${TARGET}")
    endif()
    if(NOT GM_ROOT_NAMESPACE)
        set(GM_ROOT_NAMESPACE                                           "${TARGET}")
    endif()
    if(NOT GM_SOURCE_DIR)
        set(GM_SOURCE_DIR                                               "${PROJECT_SOURCE_DIR}/game")
    endif()
    get_filename_component(GM_SOURCE_DIR                                "${GM_SOURCE_DIR}" ABSOLUTE)

    if(NOT GM_SOURCES)
        file(GLOB_RECURSE GM_SOURCES                                    CONFIGURE_DEPENDS
            "${GM_SOURCE_DIR}/*.cpp" "${GM_SOURCE_DIR}/*.cxx" "${GM_SOURCE_DIR}/*.c")
    endif()

    # --- generated entry point: every header of the module, then GLT_GAME_MODULE(<root namespace>) ---------------------
    # Reflection only sees what this one translation unit includes, so it includes all headers of the module
    if(NOT GM_NO_GENERATED_ENTRY)
        if(NOT GM_ENTRY_HEADERS)
            file(GLOB_RECURSE GM_ENTRY_HEADERS                          CONFIGURE_DEPENDS
                "${GM_SOURCE_DIR}/*.h" "${GM_SOURCE_DIR}/*.hpp" "${GM_SOURCE_DIR}/*.hh")
            list(SORT GM_ENTRY_HEADERS)
        endif()
        set(_entry "// Generated by gluttony_game_module.cmake. Do not edit: it is rewritten on every configure\n\n")
        foreach(_header IN LISTS GM_ENTRY_HEADERS)
            string(APPEND _entry "#include \"${_header}\"\n")
        endforeach()
        string(APPEND _entry "\n#include \"module/game_module.h\"\n\nGLT_GAME_MODULE(${GM_ROOT_NAMESPACE})\n")
        set(_entry_file "${CMAKE_CURRENT_BINARY_DIR}/glt_generated/${GM_MODULE_NAME}_module_entry.cpp")
        file(CONFIGURE OUTPUT "${_entry_file}" CONTENT "${_entry}" @ONLY)  # only touched when the content changes
        list(APPEND GM_SOURCES                                          "${_entry_file}")
    endif()

    if(NOT GM_SOURCES)
        message(FATAL_ERROR "gluttony_add_game_module(${TARGET}): no sources in ${GM_SOURCE_DIR}")
    endif()

    # --- the library --------------------------------------------------------------------------------------------------
    set(_config_dir "$<IF:$<CONFIG:Debug>,debug,$<IF:$<CONFIG:RelWithDebInfo>,release_with_debug_info,release>>")
    set(_bin_dir    "${PROJECT_SOURCE_DIR}/build/${_config_dir}/bin")

    add_library(${TARGET}                                               MODULE ${GM_SOURCES})
    set_target_properties(${TARGET}                                     PROPERTIES
        PREFIX                                                          ""
        OUTPUT_NAME                                                     "${GM_MODULE_NAME}"
        DEBUG_POSTFIX                                                   ""
        RELEASE_POSTFIX                                                 ""
        RELWITHDEBINFO_POSTFIX                                          ""
        LIBRARY_OUTPUT_DIRECTORY                                        "${_bin_dir}"
        POSITION_INDEPENDENT_CODE                                       ON
        CXX_VISIBILITY_PRESET                                           default     # like the plugins: inline statics are shared with the engine
        VISIBILITY_INLINES_HIDDEN                                       OFF
    )
    if(GCC16_RUNTIME_DIR)
        set_target_properties(${TARGET}                                 PROPERTIES BUILD_RPATH "${GCC16_RUNTIME_DIR}")
    endif()

    target_include_directories(${TARGET}                                PRIVATE
        "${GM_SOURCE_DIR}"
        "${_GLT_ENGINE_DIR}/core/src"
        "${_GLT_ENGINE_DIR}/vendor/glm"
        "${_GLT_ENGINE_DIR}/vendor/imgui"
        "${_GLT_ENGINE_DIR}/vendor/imgui/backends"
        "${_GLT_ENGINE_DIR}/vendor/ImGuizmo/src"
    )
    target_compile_definitions(${TARGET}                                PRIVATE
        GLT_MODULE_NAME="${GM_MODULE_NAME}"
        GLT_GAME_MODULE_BUILD
        $<$<CONFIG:Debug>:DEBUG>
        $<$<CONFIG:Release>:RELEASE>
        $<$<CONFIG:MinSizeRel>:RELEASE>
        $<$<CONFIG:RelWithDebInfo>:RELEASE_WITH_DEBUG_INFO>
        IMGUI_DEFINE_MATH_OPERATORS
        USE_IMGUI
        $<$<PLATFORM_ID:Linux>:PLATFORM_LINUX>
        $<$<PLATFORM_ID:Windows>:PLATFORM_WINDOWS>
    )
    if(GLUTTONY_TRACY)
        target_include_directories(${TARGET}                            PRIVATE "${_GLT_ENGINE_DIR}/vendor/tracy/public")
        target_compile_definitions(${TARGET}                            PRIVATE TRACY_ENABLE TRACY_ON_DEMAND GLT_TRACY_ENABLED)
    endif()
    target_compile_options(${TARGET}                                    PRIVATE
        $<$<COMPILE_LANGUAGE:CXX>:-std=c++26>
        $<$<COMPILE_LANGUAGE:CXX>:-freflection>
        $<$<COMPILE_LANGUAGE:CXX>:-ftemplate-depth=512>
        $<$<COMPILE_LANGUAGE:CXX>:-fdiagnostics-color=always>
        $<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CONFIG:Debug>>:-g3>
        # Inline variables and statics of inline functions (reflection descriptors, field tables, ...) are otherwise
        # STB_GNU_UNIQUE: the loader binds a reloaded module's copies to the FIRST loaded build's (old layouts, old
        # code) and never unmaps that build. Hot reload needs every build to own its copies
        $<$<CXX_COMPILER_ID:GNU>:-fno-gnu-unique>
        -Wall -Wextra -Wpedantic
    )
    target_precompile_headers(${TARGET}                                 PRIVATE "${_GLT_ENGINE_DIR}/core/src/util/pch.h")
    if(GM_LINK)
        target_link_libraries(${TARGET}                                 PRIVATE ${GM_LINK})
    endif()

    # --- manifest: tells the engine which file in bin/ is a module (bin/ also holds the libraries modules link) ------
    file(GENERATE OUTPUT "${_bin_dir}/${GM_MODULE_NAME}.glt_module"
        CONTENT "# Gluttony game module (generated by gluttony_game_module.cmake)\nname: ${GM_MODULE_NAME}\nroot_namespace: ${GM_ROOT_NAMESPACE}\nlibrary: $<TARGET_FILE_NAME:${TARGET}>\n")

    message(STATUS "Gluttony game module [${GM_MODULE_NAME}] (namespace ${GM_ROOT_NAMESPACE}) -> ${PROJECT_SOURCE_DIR}/build/<config>/bin")
endfunction()
